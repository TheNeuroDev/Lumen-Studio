{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lumen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Lumen desktop GPU",
      "options": { "baseURL": "https://YOUR-DESKTOP.YOUR-TAILNET.ts.net/llm/v1" },
      "models": {
        "lumen-code": { "name": "Your code model", "limit": { "context": 131072, "output": 16384 } }
      }
    }
  },
  "enabled_providers": ["lumen"],
  "model": "lumen/lumen-code",
  "small_model": "lumen/lumen-code",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "edit": "allow",
    "read": "allow",
    "bash": "ask",
    "webfetch": "allow",
    "external_directory": "deny"
  }
}
